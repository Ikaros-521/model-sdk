{
  "name": "@ai-employee/model-sdk",
  "version": "0.1.0",
  "description": "Standalone streaming model SDK extracted from DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "patches",
    "examples",
    "playground"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./providers/pi-ai": {
      "types": "./dist/providers/pi-ai/index.d.ts",
      "import": "./dist/providers/pi-ai/index.js"
    },
    "./providers/deepseek": {
      "types": "./dist/providers/deepseek/index.d.ts",
      "import": "./dist/providers/deepseek/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "import": "./dist/attachments/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js"
    },
    "./retry": {
      "types": "./dist/retry/index.d.ts",
      "import": "./dist/retry/index.js"
    },
    "./auth/oauth": {
      "types": "./dist/auth/oauth.d.ts",
      "import": "./dist/auth/oauth.js"
    }
  },
  "scripts": {
    "build": "node scripts/patch-pi-ai.mjs && tsc -p tsconfig.json",
    "test": "vitest run && node --import tsx --test test/embeddings.test.ts && node --test test/patch-pi-ai.test.mjs",
    "prepack": "npm run build",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "pretest": "node scripts/patch-pi-ai.mjs",
    "playground": "node playground/server.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "eventsource-parser": "3.0.6"
  },
  "bundleDependencies": [
    "@earendil-works/pi-ai"
  ],
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "fast-check": "^4.3.0",
    "tsx": "^4.21.0"
  }
}
